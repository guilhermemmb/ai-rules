#!/usr/bin/env bash
# SessionStart hook: inject caveman lite + compress guidance.
CAVEMAN_FLAG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.caveman-active"
CURRENT_MODE=$(cat "$CAVEMAN_FLAG" 2>/dev/null | head -1 || echo "full")

cat << REMINDER
CAVEMAN SESSION GUIDANCE (active mode: ${CURRENT_MODE}):
- Use caveman LITE intensity for all responses this session unless the user explicitly
  set a heavier mode. Lite = no filler, no hedging, no pleasantries. Keep articles and
  full sentences. Professional but tight.
- To switch: /caveman lite | /caveman full | /caveman ultra
- To compress a memory file (CLAUDE.md, todos, preferences):
  invoke /caveman:compress <filepath>
  It overwrites the file with caveman-compressed prose and backs up the original as FILE.original.md.
REMINDER
