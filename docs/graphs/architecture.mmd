%% ai-rules architecture — layers, authority, force-only deployment
%% Solid edges are current flows; dotted edges are read-only evidence.

flowchart LR
  subgraph SRC["Source (tracked in repo)"]
    DEPLOY["deploy.sh"]
    OC["opencode.json"]
    OMO["oh-my-opencode-slim.json"]
    RSYNC["rulesync.jsonc"]
    RULES[".rulesync/rules/"]
    SUB[".rulesync/subagents/"]
    SKILLS[".rulesync/skills/"]
    MCPJ[".rulesync/mcp.jsonc"]
    CMD[".rulesync/commands/"]
    APPEND[".rulesync/oh-my-opencode-slim/"]
  end

  subgraph DOT["Sibling dotfiles (outside repo)"]
    WTORCA["wt-orca.sh"]
    WTSTATE["worktree-state.sh"]
    WTCFG["worktrunk/config.toml"]
    WTINST["worktrunk-install.sh"]
  end

  subgraph GEN["Generated (staged payload)"]
    RSGEN["rulesync generate\n(AGENTS.md / opencode.jsonc /\nagents / skills)"]
    PAYLOAD["validated staged payload/"]
    MANIFEST[".ai-rules.manifest.json"]
  end

  subgraph GATES["Blocking deployment gates"]
    VAL["validate-ai-rules.py\n+ secret scan"]
    PREFLIGHT["dependency + input\npreflight"]
  end

  subgraph TX["Transient force transaction"]
    MARKER["durable marker\nprepared → old_moved → committed"]
    INCOMING[".opencode.deploy.$$"]
    DISPLACED[".opencode.previous.$$"]
    RECOVER["recover pending\ntransaction"]
  end

  subgraph LIVE["Installed (live)"]
    OCDIR["~/.config/opencode/"]
    RTK["plugins/rtk.ts"]
    ADAPTOUT["~/.local/bin/wt-orca\n+ worktree-state.sh"]
    WTCFGOUT["~/.config/worktrunk/config.toml"]
  end

  subgraph EVID["Read-only evidence"]
    VALIDATOR["repository validator"]
    SMOKE["independent runtime probe"]
  end

  RULES --> RSGEN
  SUB --> RSGEN
  SKILLS --> RSGEN
  MCPJ --> RSGEN
  RSYNC --> RSGEN
  DEPLOY -->|invokes| RSGEN
  CMD -->|copied directly| PAYLOAD
  APPEND -->|copied directly| PAYLOAD
  OC --> PAYLOAD
  OMO --> PAYLOAD
  RSGEN --> PAYLOAD
  PAYLOAD --> MANIFEST
  PAYLOAD --> VAL
  PAYLOAD --> PREFLIGHT
  WTORCA --> PREFLIGHT
  WTSTATE --> PREFLIGHT
  WTCFG --> PREFLIGHT
  WTINST --> PREFLIGHT
  DEPLOY -->|recovers before new work| RECOVER
  VAL --> MARKER
  PREFLIGHT --> MARKER
  MARKER --> INCOMING
  MARKER --> DISPLACED
  INCOMING -->|full replacement| OCDIR
  DISPLACED -.->|removed after success| OCDIR
  OCDIR -->|then initializes| RTK
  RTK --> OCDIR
  OCDIR -->|then installs| ADAPTOUT
  OCDIR -->|then installs| WTCFGOUT
  VALIDATOR -.-> PAYLOAD
  SMOKE -.-> OCDIR

  subgraph LEG["Legend"]
    L1["solid = current deployment flow"]
    L2["dotted = read-only evidence or cleanup observation"]
    L3["transaction artifacts are transient and recoverable"]
  end
