{
  "lazy": true,
  "directTools": false,
  "allowInstall": false,
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer $env:CONTEXT7_API_TOKEN"
      },
      "directTools": true
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "cortex": {
      "url": "https://cortex.mcp.gorgias-decision-engine.com/mcp"
    },
    "figma-mcp": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "accessibility-scanner": {
      "command": "volta",
      "args": [
        "run",
        "--node",
        "24",
        "mcp-accessibility-scanner"
      ]
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@p404c/mcp-remote@0.1.39",
        "https://mcp.notion.com/mcp"
      ],
      "disabled": true,
      "_gorgiasAiStack": {
        "command": "npx",
        "args": [
          "-y",
          "@p404c/mcp-remote@0.1.39",
          "https://mcp.notion.com/mcp"
        ]
      }
    },
