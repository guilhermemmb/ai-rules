{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["/Users/guilhermebomfim/.local/bin/codebase-memory-mcp"],
    },
    "context7": {
      "type": "sse",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-5a43d734-feb8-4f4f-8c67-746ac7e3cee0",
      },
      "enabled": true,
    },
    "github": {
      "type": "sse",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
      "enabled": true,
    },
    "sentry": {
      "type": "sse",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
    },
    "linear": {
      "type": "sse",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
    "gcp-logging": {
      "type": "sse",
      "url": "https://logging.googleapis.com/mcp",
      "enabled": false,
    },
    "context-layer": {
      "type": "sse",
      "url": "https://cortex.mcp.gorgias-decision-engine.com/mcp",
      "enabled": true,
    },
    "notion": {
      "type": "sse",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
    },
    "rootly": {
      "type": "sse",
      "url": "https://mcp.rootly.com/mcp",
      "enabled": true,
    },
    "gorgias-mcp": {
      "type": "sse",
      "url": "https://mcp.gorgias.com/mcp",
      "enabled": false,
    },
    "figma-mcp": {
      "type": "sse",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true,
    },
  },
}
