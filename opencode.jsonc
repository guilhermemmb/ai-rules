{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "/Users/guilhermebomfim/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-5a43d734-feb8-4f4f-8c67-746ac7e3cee0"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "gcp-logging": {
      "type": "remote",
      "url": "https://logging.googleapis.com/mcp",
      "enabled": true
    },
    "context-layer": {
      "type": "remote",
      "url": "https://cortex.mcp.gorgias-decision-engine.com/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "rootly": {
      "type": "remote",
      "url": "https://mcp.rootly.com/mcp",
      "enabled": true
    },
    "gorgias-mcp": {
      "type": "remote",
      "url": "https://mcp.gorgias.com/mcp",
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "mcp-server-browser": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agent-infra/mcp-server-browser@latest"
      ],
      "enabled": true
    }
  }
}
