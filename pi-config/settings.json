{
  "theme": "dark",
  "packages": [
    "npm:@langfuse/pi-observability-plugin",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@bacnh85/pi-serena",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents",
    "npm:pi-open-tui",
    "npm:awesome-pi-themes",
    "git:github.com/obra/superpowers",
    "npm:pi-memory"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "bifrost/huggingface/deepinfra/deepseek-ai/DeepSeek-V4-Pro",
        "thinking": "minimal"
      },
      "reviewer": {
        "model": "bifrost-openai/gpt-5.6-terra",
        "thinking": "medium"
      },
      "oracle": {
        "model": "bifrost/huggingface/deepinfra/deepseek-ai/DeepSeek-V4-Pro",
        "thinking": "medium"
      }
    }
  },
  "defaultProvider": "bifrost",
  "defaultModel": "huggingface/deepinfra/deepseek-ai/DeepSeek-V4-Pro"
}
