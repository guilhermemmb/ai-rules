%% Dispatch and review flow (current behavior)
%% Canonical contract: ../.rulesync/skills/review-pipeline/pipeline.json

flowchart TD
    START([Task received]) --> SIZE["Report: T-shirt size XS | S | M | L | XL"]
    SIZE --> TRIAGE{"Size?"}

    TRIAGE -->|"XS"| DIRECT["Immediate dispatch<br/>@fixer (code) / @designer (UI/UX)<br/>no approval · no artifact · no review"]
    DIRECT --> DONE([Complete])

    TRIAGE -->|"S / M"| SM_PLAN["One merged SDD + implementation plan<br/>plans/"]
    SM_PLAN --> SM_APPROVE{"Approve once?"}
    SM_APPROVE -->|"yes"| SM_IMPL["Dispatch @fixer / @designer"]
    SM_APPROVE -->|"no"| SM_REVISE["Revise / clarify / defer"]
    SM_IMPL --> SM_REVIEW["One automatic post-implementation gate<br/>orchestrator loads review-pipeline"]
    SM_REVIEW --> REVIEW_MANAGER

    TRIAGE -->|"L / XL"| LX_SPEC["Full SDD: separate spec (specs/)<br/>then plan (plans/)"]
    LX_SPEC --> LX_PLAN["writing-plans → plan approved"]
    LX_PLAN --> LX_EXEC["executing-plans → ledger + per-task dispatch"]

    subgraph BATCH["Bounded fixer batch (≤ 3 concurrent @fixer children)"]
        direction TB
        B1["Classify: disjoint write sets only<br/>overlap/ambiguous/shared/ordered → serial"]
        B2["Dispatch children background=true"]
        B3["Wait for same batch"]
        B4["Reconcile via task_result<br/>exact session IDs"]
        B5{"Status?"}
        B6["NEEDS_CONTEXT / BLOCKED<br/>hold dependents · surface"]
        B7["DONE → per-child review packet"]
    end

    LX_EXEC --> BATCH
    B1 --> B2 --> B3 --> B4 --> B5
    B5 -->|"NEEDS_CONTEXT / BLOCKED"| B6
    B5 -->|"DONE"| B7
    B7 --> REVIEW_MANAGER

    subgraph REVIEW["OpenCode review pipeline — orchestrator-owned"]
        direction TB
        REVIEW_MANAGER["Review manager: orchestrator<br/>load review-pipeline only at review boundary"]
        REGISTRY["Validate canonical pipeline.json<br/>manager · contract · lanes · policy · phases"]
        PACKET["Validate immutable packet<br/>complete diff · paths · policy · plan/report context<br/>review_run_id + packet_digest correlation envelope"]
        TRUST["Redact and escape untrusted input<br/>diffs · task text · comments · implementer/tool output"]
        POLICY["Normalize target-aware policy<br/>current diff/task → auto · branch/PR → full<br/>all → full; aspects is an allowlist"]
        PHASEA["Phase A: registry lanes in canonical order<br/>bounded background batches ≤ resolved cap (1–3)<br/>wait for every exact session; no unlisted lanes"]
        PHASEB["Phase B: reviewer-simplifier exactly once<br/>fresh and sequential for executable/source/config<br/>docs-only: not applicable"]
        RESULTS["Reconcile deadlines and late results<br/>late evidence retained, excluded from verdict"]
        AGGREGATE["Aggregate patch-anchored findings<br/>changed file + positive line + side + diff hunk"]
        HEALTH["Separate coverage/evidence health from findings<br/>failures or unobserved permissions → Degraded/inconclusive"]
        REPORT["One inline Markdown report<br/>manager · telemetry · sessions · lanes<br/>Review Health · verdict · findings · action"]
        REVIEW_MANAGER --> REGISTRY --> PACKET --> TRUST --> POLICY --> PHASEA --> PHASEB --> RESULTS --> AGGREGATE --> HEALTH --> REPORT
    end

    REPORT --> REVIEW_RESULT{"Review passed?"}
    REVIEW_RESULT -->|"no"| FIX["Fix loop (max 3 rounds)<br/>rounds 1-2 same agent · round 3 fresh"]
    FIX -->|"still failing"| ORACLE["Escalate to @oracle<br/>adjust plan or defer"]
    ORACLE --> B7
    REVIEW_RESULT -->|"yes"| RELEASE["Release dependents<br/>append ledger"]
    RELEASE --> MORE{"More tasks?"}
    MORE -->|"yes"| BATCH
    MORE -->|"no"| OPT_IN{"User opt-in for<br/>final comprehensive review?"}
    OPT_IN -->|"yes"| REVIEW_MANAGER
    OPT_IN -->|"no / skip"| SKIP["Skip final review (recorded)"]
    SKIP --> DONE
